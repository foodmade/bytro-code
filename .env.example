# Bytro Community Edition local preview configuration
#
# Copy this file to .env.local only when you use the optional self-hosted
# preview Worker. Provider credentials and local CLI paths are configured in
# the application or inherited from the launch environment; this file is not a
# general-purpose provider credential store.
#
# Never commit .env, .env.local, provider auth files, or real secrets.

# Optional self-hosted static preview Worker.
# The desktop needs only these two values. Cloudflare account and R2
# credentials belong in Wrangler/Cloudflare, never in this file.
BYTRO_DEPLOY_WORKER_URL=
BYTRO_DEPLOY_API_KEY=
