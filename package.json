{
  "name": "bytro-community",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop workspace for user-configured AI coding agents.",
  "license": "Apache-2.0",
  "author": "misschendo and contributors",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "build:sidecar": "npm --prefix sidecar run build:bundle",
    "lint": "eslint src sidecar/src services/site-preview-worker/src",
    "lint:ci": "eslint src sidecar/src services/site-preview-worker/src --max-warnings 135",
    "lint:fix": "eslint src sidecar/src services/site-preview-worker/src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:sidecar": "npm --prefix sidecar test",
    "test:watch": "vitest",
    "typecheck:sidecar": "npm --prefix sidecar run typecheck",
    "typecheck:worker": "npm --prefix services/site-preview-worker run typecheck",
    "check:worker": "npm --prefix services/site-preview-worker test && npm --prefix services/site-preview-worker run typecheck && npm --prefix services/site-preview-worker run build:check",
    "check:community": "node scripts/check-community-config.cjs",
    "check:third-party": "node scripts/check-third-party-compliance.cjs",
    "check:third-party:strict": "node scripts/check-third-party-compliance.cjs --strict",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features",
    "audit:dependencies": "npm audit --audit-level=high && npm --prefix sidecar audit --audit-level=high && npm --prefix services/site-preview-worker audit --audit-level=high",
    "ci:gate": "npm run audit:dependencies && npm run check:community && npm run lint:ci && npm test && npm run test:sidecar && npm run build && npm run typecheck:sidecar && npm run build:sidecar && npm run check:worker && npm run check:third-party && npm run check:rust && npm run test:rust && npm run ci:rust-strict",
    "ci:rust-strict": "npm run check:rust:fmt && npm run check:rust:clippy",
    "tauri": "tauri",
    "build:mac-arm64": "tauri build --target aarch64-apple-darwin",
    "build:mac-x64": "tauri build --target x86_64-apple-darwin",
    "check:secrets": "node scripts/check-staged-secrets.cjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "ansi_up": "^6.0.6",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "partial-json": "^0.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.62.3"
  }
}
